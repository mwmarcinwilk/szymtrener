# Skopiuj do .env i uzupełnij. Plik .env jest lokalny, nie commituj go.
#
#   cp .env.example .env
#
# Wersja na wdrożenie: patrz deploy/README.md.

# ─── Baza ────────────────────────────────────────────────────────────
# DB_PORT to port na hoscie, ktory publikuje kontener z docker-compose.yml.
# Zostaw 5432, jesli nic innego go nie zajmuje. Jesli masz Postgres.app albo
# postgresa z Homebrew, uzyj 5433 i nie bedziesz musial ich wylaczac.
DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/szymtrener
DB_USER=szymtrener
DB_PASSWORD=szymtrener

# ─── Panel ───────────────────────────────────────────────────────────
# ADMIN_PASSWORD zaklada konto przy PIERWSZYM starcie na pustej bazie.
# Potem haslo zmieniasz w /admin/haslo, a te zmienna mozna usunac.
ADMIN_EMAIL=szymtrener@gmail.com
ADMIN_PASSWORD=ZmienToHaslo123

# ─── Reszta ──────────────────────────────────────────────────────────
SITE_URL=http://localhost:8080

# Sol do hashowania identyfikatora sesji w statystykach. Lokalnie dowolna,
# na produkcji losowa i nigdy domyslna.
ANALYTICS_SALT=lokalna-sol-do-zmiany

# Poczta. Bez hasla aplikacja wstanie normalnie, tylko wysylka bedzie sie wykladac:
# zgloszenie i tak zapisze sie w bazie, a blad trafi do submission.mail_error.
# Lokalnie zwykle zostawiasz puste.
MAIL_PASSWORD=

# ── Poczta przez Gmail ──────────────────────────────────────────────────────
# 1. Włącz weryfikację dwuetapową na koncie Google (bez niej nie ma haseł aplikacji).
# 2. Konto Google → Bezpieczeństwo → Hasła aplikacji → wygeneruj 16-znakowe hasło.
# 3. Wpisz je do MAIL_PASSWORD (bez spacji). Zwykłe hasło do konta NIE zadziała.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=twoj.adres@gmail.com
# MAIL_FROM zostaw puste — nadawcą będzie MAIL_USER. Inny adres podaj tylko wtedy,
# gdy masz go dodanego w Gmailu jako „Wysyłaj jako" i zweryfikowanego.
# MAIL_FROM=

# Ping do wyszukiwarek po publikacji. Lokalnie zawsze wylaczone.
INDEXNOW_ENABLED=false
INDEXNOW_KEY=
